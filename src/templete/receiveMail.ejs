<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Contact Form Submission</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f5f7; font-family: 'Helvetica Neue', Arial, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
    style="background-color:#f4f5f7; padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0"
          style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.06);">

          <!-- Header -->
          <tr>
            <td style="background-color:#111827; padding:24px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="color:#ffffff; font-size:16px; font-weight:600; letter-spacing:0.3px;">
                    Portfolio Contact Form
                  </td>
                  <td align="right">
                    <span
                      style="display:inline-block; background-color:#22c55e; color:#052e16; font-size:11px; font-weight:600; padding:4px 10px; border-radius:999px;">
                      NEW MESSAGE
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Intro -->
          <tr>
            <td style="padding:28px 32px 4px 32px;">
              <p style="margin:0 0 4px 0; font-size:15px; color:#374151;">
                You've received a new message from your portfolio contact form.
              </p>
            </td>
          </tr>

          <!-- Sender Info Card -->
          <tr>
            <td style="padding:20px 32px 8px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td width="80" style="font-size:13px; color:#6b7280; padding:4px 0; vertical-align:top;">Name
                        </td>
                        <td style="font-size:14px; color:#111827; font-weight:600; padding:4px 0;">John Doe</td>
                      </tr>
                      <tr>
                        <td width="80" style="font-size:13px; color:#6b7280; padding:4px 0; vertical-align:top;">Email
                        </td>
                        <td style="font-size:14px; padding:4px 0;">
                          <a href="mailto:john.doe@example.com"
                            style="color:#2563eb; text-decoration:none; font-weight:500;">john.doe@example.com</a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Message -->
          <tr>
            <td style="padding:16px 32px 8px 32px;">
              <p
                style="margin:0 0 8px 0; font-size:13px; color:#6b7280; font-weight:600; text-transform:uppercase; letter-spacing:0.4px;">
                Message
              </p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#ffffff; border:1px solid #e5e7eb; border-left:3px solid #111827; border-radius:6px;">
                <tr>
                  <td style="padding:16px 18px; font-size:14px; line-height:1.7; color:#374151; white-space:pre-wrap;">
                    Hi Shahdat, I checked out your portfolio and I'm really impressed with the FixItNow project. I'd
                    love to talk about a potential freelance opportunity — are you available for a quick call this week?
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="padding:24px 32px 8px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="border-radius:6px; background-color:#111827;">
                    <a href="mailto:john.doe@example.com"
                      style="display:inline-block; padding:12px 22px; font-size:14px; color:#ffffff; text-decoration:none; font-weight:500;">
                      Reply to John Doe
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:20px 32px 0 32px;">
              <hr style="border:none; border-top:1px solid #e5e7eb; margin:0;" />
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:16px 32px 24px 32px;">
              <p style="margin:0; font-size:12px; color:#9ca3af;">
                This notification was generated automatically from the contact form on your portfolio site.
              </p>
            </td>
          </tr>

        </table>

        <p style="margin:16px 0 0 0; font-size:12px; color:#9ca3af;">
          &copy; 2026 Shahdat Hossain. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>

</html>