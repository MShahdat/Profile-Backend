<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Message Received</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f5f7; font-family:'Helvetica Neue', Arial, sans-serif;">

  <!-- Inbox preview text (hidden in the email body) -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; font-size:1px; line-height:1px; color:#f4f5f7;">
    Thanks for reaching out, <%= name %>. I've received your message and will reply personally within 24&ndash;48 hours.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
    style="background-color:#f4f5f7; padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0"
          style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.06);">

          <!-- Header -->
          <tr>
            <td style="background-color:#111827; padding:28px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="color:#ffffff; font-size:18px; font-weight:600; letter-spacing:0.3px;">
                    Shahdat Hossain
                  </td>
                  <td align="right" style="color:#9ca3af; font-size:12px;">
                    Full-Stack Developer
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Status badge -->
          <tr>
            <td style="padding:32px 32px 0 32px;">
              <span
                style="display:inline-block; background-color:#dcfce7; color:#166534; font-size:11px; font-weight:600; letter-spacing:0.4px; padding:5px 12px; border-radius:999px;">
                &#10003;&nbsp; MESSAGE RECEIVED
              </span>
            </td>
          </tr>

          <!-- Greeting & intro -->
          <tr>
            <td style="padding:16px 32px 0 32px;">
              <h1 style="margin:0 0 12px 0; font-size:22px; line-height:1.3; color:#111827; font-weight:700;">
                Thanks for reaching out, <%= name %>.
              </h1>
              <p style="margin:0 0 16px 0; font-size:15px; line-height:1.7; color:#374151;">
                I've received your message through my portfolio and genuinely appreciate you taking the time to write.
                I read every message personally, so you'll hear back from me directly.
              </p>
            </td>
          </tr>

          <% if (locals.message) { %>
            <!-- Copy of the visitor's message -->
            <tr>
              <td style="padding:4px 32px 8px 32px;">
                <p
                  style="margin:0 0 8px 0; font-size:12px; color:#6b7280; font-weight:600; text-transform:uppercase; letter-spacing:0.4px;">
                  Your message
                </p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                  style="background-color:#f9fafb; border:1px solid #e5e7eb; border-left:3px solid #111827; border-radius:6px;">
                  <tr>
                    <td
                      style="padding:14px 16px; font-size:14px; line-height:1.7; color:#4b5563; white-space:pre-wrap;">
                      <%= message %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <% } %>

              <!-- What happens next -->
              <tr>
                <td style="padding:24px 32px 8px 32px;">
                  <p
                    style="margin:0 0 14px 0; font-size:12px; color:#6b7280; font-weight:600; text-transform:uppercase; letter-spacing:0.4px;">
                    What happens next
                  </p>

                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                      <td width="32" valign="top" style="padding:0 0 14px 0;">
                        <div
                          style="width:24px; height:24px; line-height:24px; text-align:center; border-radius:50%; background-color:#111827; color:#ffffff; font-size:12px; font-weight:600;">
                          1</div>
                      </td>
                      <td valign="top" style="padding:2px 0 14px 0; font-size:14px; line-height:1.6; color:#374151;">
                        <strong style="color:#111827;">I review your message</strong><br />
                        I'll go through the details of your request or idea.
                      </td>
                    </tr>
                    <tr>
                      <td width="32" valign="top" style="padding:0 0 14px 0;">
                        <div
                          style="width:24px; height:24px; line-height:24px; text-align:center; border-radius:50%; background-color:#111827; color:#ffffff; font-size:12px; font-weight:600;">
                          2</div>
                      </td>
                      <td valign="top" style="padding:2px 0 14px 0; font-size:14px; line-height:1.6; color:#374151;">
                        <strong style="color:#111827;">You get a personal reply</strong><br />
                        Usually within <strong>24&ndash;48 hours</strong>. If it's urgent, just say so in your reply to
                        this email.
                      </td>
                    </tr>
                    <tr>
                      <td width="32" valign="top" style="padding:0;">
                        <div
                          style="width:24px; height:24px; line-height:24px; text-align:center; border-radius:50%; background-color:#111827; color:#ffffff; font-size:12px; font-weight:600;">
                          3</div>
                      </td>
                      <td valign="top" style="padding:2px 0 0 0; font-size:14px; line-height:1.6; color:#374151;">
                        <strong style="color:#111827;">We take it from there</strong><br />
                        A quick call or a few emails to figure out the best next step.
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- CTA -->
              <tr>
                <td style="padding:24px 32px 8px 32px;">
                  <p style="margin:0 0 14px 0; font-size:15px; line-height:1.6; color:#374151;">
                    While you wait, feel free to explore some of my recent work.
                  </p>
                  <table role="presentation" cellpadding="0" cellspacing="0">
                    <tr>
                      <td style="border-radius:6px; background-color:#111827;">
                        <a href="https://md-shahdat-hossain.vercel.app"
                          style="display:inline-block; padding:12px 24px; font-size:14px; color:#ffffff; text-decoration:none; font-weight:500;">
                          View My Work &rarr;
                        </a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Sign-off -->
              <tr>
                <td style="padding:28px 32px 28px 32px;">
                  <p style="margin:0 0 2px 0; font-size:15px; color:#374151;">Best regards,</p>
                  <p style="margin:0; font-size:15px; font-weight:600; color:#111827;">Md. Shahdat Hossain</p>
                </td>
              </tr>

              <!-- Divider -->
              <tr>
                <td style="padding:0 32px;">
                  <hr style="border:none; border-top:1px solid #e5e7eb; margin:0;" />
                </td>
              </tr>

              <!-- Footer -->
              <tr>
                <td style="padding:20px 32px 28px 32px;">
                  <p style="margin:0 0 10px 0; font-size:13px; color:#6b7280;">
                    Connect with me:
                    <a href="https://github.com/MShahdat"
                      style="color:#111827; text-decoration:none; font-weight:500; margin:0 6px;">GitHub</a>&bull;
                    <a href="https://www.linkedin.com/in/md-shahdat-hossain/"
                      style="color:#111827; text-decoration:none; font-weight:500; margin:0 6px;">LinkedIn</a>&bull;
                    <a href="https://md-shahdat-hossain.vercel.app"
                      style="color:#111827; text-decoration:none; font-weight:500; margin:0 6px;">Portfolio</a>
                  </p>
                  <p style="margin:0; font-size:12px; line-height:1.5; color:#9ca3af;">
                    This is an automated confirmation. My personal reply will follow shortly.
                  </p>
                </td>
              </tr>

        </table>

        <p style="margin:16px 0 0 0; font-size:12px; color:#9ca3af;">
          &copy; <%= new Date().getFullYear() %> Shahdat Hossain. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>

</html>