model SiteConfig {
  id String @id @default(uuid())

  name           String
  email          String  @unique
  phone          String
  resumeUrl      String?
  resumePublicId String?
  cvUrl          String?
  cvPublicId     String?
  available      Boolean @default(true)

  image            String
  imagePublicId    String
  title            String
  aboutDescription String
  experience       Int?
  totalProjects    Int?
  happyClients     Int?

  greeting        String
  role            String
  titleLine       String[]
  heroDescription String
  passion         String

  footerTxt     String?
  footerTagline String?

  github        String?
  githubIcon    String?
  linkedin      String?
  linkedinIcon  String?
  facebook      String?
  facebookIcon  String?
  twitter       String?
  twitterIcon   String?
  instagram     String?
  instagramIcon String?
  youTube       String?
  youTubeIcon   String?

  primaryColor   String?
  secondaryColor String?
  ternaryColor   String?

  isPublished Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("siteConfig")
}
